{
  // The dashboard, the shared core and their tests, checked as browser code.
  //
  // This project has no Node types, so a Node API in `src/core` or
  // `src/dashboard` fails the typecheck here.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "useDefineForClassFields": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "paths": {
      "@cli/*": ["./src/cli/*"],
      "@core/*": ["./src/core/*"],
      "@collector/*": ["./src/collector/*"],
      "@dashboard/*": ["./src/dashboard/*"],
      "@desktop/*": ["./src/desktop/*"],
      "@tests/*": ["./tests/*"]
    }
  },
  "include": [
    "src/dashboard",
    "src/core",
    "tests/component",
    "tests/unit/dashboard",
    "tests/unit/core",
    // Vitest loads this by path and no test imports it, so it is named here.
    "tests/support/browser/componentSetup.ts"
  ]
}
