{
  // The collector, the shared core and their tests, checked as Node code.
  //
  // `src/core` is listed as well as in tsconfig.app.json. The collector imports
  // it, and this project has no DOM lib, so checking it here is what holds core
  // to its rule of using no browser APIs.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.collector.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "paths": {
      "@core/*": ["./src/core/*"],
      "@collector/*": ["./src/collector/*"],
      "@dashboard/*": ["./src/dashboard/*"],
      "@tests/*": ["./tests/*"]
    }
  },
  "include": [
    "src/collector",
    "src/core",
    "tests/integration",
    "tests/unit/collector",
    "tests/unit/core"
  ]
}
