{
  "name": "agent-lookout",
  "version": "0.2.6",
  "description": "Shows the AI agent sessions on your computer in one browser page, and which need you.",
  "keywords": [
    "ai-agents",
    "claude-code",
    "claude",
    "codex",
    "mcp",
    "mcp-server",
    "tmux",
    "dashboard",
    "monitoring",
    "developer-tools"
  ],
  "homepage": "https://agent-lookout.vercel.app",
  "bugs": {
    "url": "https://github.com/Olanetsoft/agent-lookout/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Olanetsoft/agent-lookout.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-lookout": "bin/agent-lookout.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "docs/API.md",
    "docs/GUIDE.md",
    "CHANGELOG.md",
    "DISCLAIMER.md",
    "LICENSE",
    "PRIVACY.md",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:package": "npm run build && node scripts/build-package.mjs",
    "prepack": "npm run build:package",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs",
    "dev:desktop": "npm run build:desktop && electron dist-electron",
    "dist:mac": "npm run build:desktop && electron-builder --mac --publish never",
    "start": "tsx src/collector/hosts/serve.ts",
    "start:check": "node scripts/start-check.mjs",
    "status": "node bin/agent-lookout.mjs status",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:component": "vitest run --project component",
    "test:watch": "vitest",
    "check:layout": "node scripts/check-layout.mjs",
    "check": "npm run check:layout && npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "nodemailer": "^10.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.1.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "lucide-react": "^1.51.0",
    "motion": "^14.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "vitest-browser-react": "^2.3.0",
    "zod": "^4.6.5"
  }
}
